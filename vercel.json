{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "git": { "deploymentEnabled": false },
  "installCommand": "bun install --frozen-lockfile",
  "buildCommand": "node ace build --ignore-ts-errors && cd build && bun install --frozen-lockfile --production && node ../scripts/vercel_manifest.mjs .",
  "outputDirectory": "build/public",
  "functions": {
    "api/index.mjs": {
      "includeFiles": "{build/resources/**,build/public/assets/.vite/**,build/node_modules/{openai/lib/**/*.js,@fontsource/**/*.woff2,@fontsource-variable/**/*.woff2,@napi-rs/canvas/**,@napi-rs/canvas-linux-x64-gnu/**,pdfjs-dist/standard_fonts/**,pdfjs-dist/cmaps/**}}",
      "excludeFiles": "{build/node_modules/**/*musl*/**,build/node_modules/better-sqlite3/**}",
      "maxDuration": 300
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/api/index" }]
}
