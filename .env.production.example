# Production environment for the Vercel deployment (web) and the Railway worker.
# terraform/vercel sets ALL of these automatically from its resources and tfvars; this file is
# the reference for what ends up in Vercel/Railway, or for setting them by hand without Terraform.
# Never commit real values. [secret] = mark as Sensitive in Vercel.

# ---------------------------------------------------------------- Node / HTTP
NODE_ENV=production
HOST=0.0.0.0
PORT=3333                        # required by start/env.ts; ignored on Vercel
TZ=UTC
LOG_LEVEL=info

# ---------------------------------------------------------------- App
APP_NAME=CodeCanvas
APP_KEY=                         # [secret] node ace generate:key; changing it logs everyone out
APP_URL=https://app.example.com  # must be https (Secure session cookies)
SESSION_DRIVER=cookie

# ---------------------------------------------------------------- Neon Postgres (pgvector)
DB_HOST=ep-xxxx.us-east-1.aws.neon.tech
DB_PORT=5432
DB_USER=capstone
DB_PASSWORD=                     # [secret]
DB_DATABASE=capstone
# [secret] Web (Vercel): pooled host (note "-pooler"). Worker: direct host (no "-pooler").
DB_URL=postgres://capstone:PASSWORD@ep-xxxx-pooler.us-east-1.aws.neon.tech/capstone?sslmode=require

# ---------------------------------------------------------------- OpenRouter
OPENROUTER_API_KEY=              # [secret]
OPENROUTER_MODEL=anthropic/claude-haiku-5.5
OPENROUTER_EMBEDDING_MODEL=perplexity/pplx-embed-v1-4b

# ---------------------------------------------------------------- Neon Object Storage (S3-compatible)
# Bucket + credential are created by terraform/vercel/storage.tf. By hand: create a private bucket and
# a storage:read+storage:write credential on the production branch (Neon Console or API).
DRIVE_DISK=s3
S3_ACCESS_KEY_ID=nak_live_...    # [secret] credential token_id
S3_SECRET_ACCESS_KEY=            # [secret] credential s3_secret_access_key (nsk_live_...)
S3_REGION=us-east-1              # "region" from GET .../branches/{branch_id}/storage
S3_BUCKET=uploads
# "s3_endpoint" from the same call; branch-specific, path-style only
S3_ENDPOINT=https://br-xxxx.storage.c-2.us-east-1.aws.neon.tech

# ---------------------------------------------------------------- Upstash Redis (queue)
QUEUE_DRIVER=redis
REDIS_HOST=xxxx.upstash.io
REDIS_PORT=6379
REDIS_PASSWORD=                  # [secret]
REDIS_TLS=true                   # Upstash only accepts TLS

# ---------------------------------------------------------------- RAG / generation
RAG_PIPELINE_VERSION=2
RAG_EMBEDDING_DIMENSIONS=1024
EMBEDDING_PROVIDER=openrouter
CONTEXTUALIZER=off
GENERATION_FORMAT=branded
# Vercel has no Python: always pdf-parse there. The Railway worker image can use pymupdf.
PDF_EXTRACTOR=pdf-parse

# ---------------------------------------------------------------- Mail (SMTP)
MAIL_MAILER=smtp
MAIL_FROM_NAME=HumbleBeeAI
MAIL_FROM_ADDRESS=hello@example.com
SMTP_HOST=email-smtp.us-east-1.amazonaws.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USERNAME=
SMTP_PASSWORD=                   # [secret]

# ---------------------------------------------------------------- Worker only (Railway)
# APP_ROLE=worker                # docker/entrypoint.sh then runs `node ace queue:work --queue=documents`
