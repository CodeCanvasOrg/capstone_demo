# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development

# App
APP_NAME=CodeCanvas
LOG_LEVEL=info
APP_KEY=
APP_URL=http://${HOST}:${PORT}

# Session
SESSION_DRIVER=cookie
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=root
DB_PASSWORD=root
DB_DATABASE=app
DB_URL=postgres://root:root@${DB_HOST}:${DB_PORT}/${DB_DATABASE}
GOOGLE_CLIENT_ID=placeholder
GOOGLE_CLIENT_SECRET=placeholder
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-6-luna
OPENROUTER_EMBEDDING_MODEL=perplexity/pplx-embed-v1-4b
DRIVE_DISK=supabase
SUPABASE_STORAGE_KEY=
SUPABASE_STORAGE_SECRET=
SUPABASE_STORAGE_REGION=
SUPABASE_STORAGE_BUCKET=
SUPABASE_ENDPOINT=
QUEUE_DRIVER=redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
RAG_PIPELINE_VERSION=1
RAG_EMBEDDING_DIMENSIONS=768
# Embeddings (config/embeddings.ts): local Ollama by default; set EMBEDDING_PROVIDER=openrouter
# with OPENROUTER_EMBEDDING_MODEL and RAG_EMBEDDING_DIMENSIONS=1024 to use OpenRouter instead.
EMBEDDING_PROVIDER=ollama
EMBEDDING_BASE_URL=http://127.0.0.1:11434/v1
EMBEDDING_MODEL=embeddinggemma-2:740m
# PDF extraction (config/pdf_worker.ts): PyMuPDF in a local Python worker pool. Prepare the
# environment once with `bun run python:setup`. Defaults to pdf-parse in production.
PDF_EXTRACTOR=pymupdf

# Explicit disposable database used by tenancy functional tests (never production)
TEST_DB_URL=
# SMTP delivery (local Mailpit example; set authenticated SMTP for deployment)
MAIL_MAILER=smtp
MAIL_FROM_NAME=HumbleBeeAI
MAIL_FROM_ADDRESS=hello@example.test
SMTP_HOST=127.0.0.1
SMTP_PORT=1026
SMTP_SECURE=false
SMTP_USERNAME=
SMTP_PASSWORD=

# Optional provider override for the checked-in local Postman simulation only
# OPENROUTER_BASE_URL=http://127.0.0.1:4900/openrouter/api/v1
