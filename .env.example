# Copy to .env for local development. In production these are injected by the platform
# (Terraform/ECS sets them from terraform/app.tf); never commit real values.
# Required = validated at boot by start/env.ts (the app refuses to start without it).

# ---------------------------------------------------------------- Node / HTTP
TZ=UTC
PORT=3333
HOST=localhost                  # production container: 0.0.0.0
NODE_ENV=development            # development | production | test
LOG_LEVEL=info

# ---------------------------------------------------------------- App
APP_NAME=CodeCanvas
# Generate with: node ace generate:key   (>= 16 chars; changing it invalidates sessions)
APP_KEY=
# Public URL users reach the app on. Production must be https:// (session cookies are Secure).
APP_URL=http://${HOST}:${PORT}
SESSION_DRIVER=cookie           # cookie | memory | database

# ---------------------------------------------------------------- PostgreSQL (needs the pgvector extension)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=root
DB_PASSWORD=root
DB_DATABASE=app
# The app connects with DB_URL. For managed Postgres that enforces TLS (e.g. AWS RDS) append
# ?sslmode=no-verify (or require a CA bundle). docker-compose.yml uses port 55433.
DB_URL=postgres://root:root@${DB_HOST}:${DB_PORT}/${DB_DATABASE}
# Explicit disposable database for functional tests (never production)
TEST_DB_URL=

# ---------------------------------------------------------------- OpenRouter (LLM + embeddings)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-haiku-5.5
OPENROUTER_EMBEDDING_MODEL=perplexity/pplx-embed-v1-4b
# Per-call deadline for document generation (default 180000 ms; a timeout is retried once)
# OPENROUTER_TIMEOUT_MS=180000
# Provider override for the checked-in local Postman simulation only
# OPENROUTER_BASE_URL=http://127.0.0.1:4900/openrouter/api/v1

# ---------------------------------------------------------------- Object storage (S3-compatible)
DRIVE_DISK=s3
S3_ACCESS_KEY_ID=test           # local Adobe S3Mock from docker-compose.yml
S3_SECRET_ACCESS_KEY=test
S3_REGION=us-east-1
S3_BUCKET=capstone
# Local: http://127.0.0.1:9090   AWS: https://s3.<region>.amazonaws.com
S3_ENDPOINT=http://127.0.0.1:9090

# ---------------------------------------------------------------- Queue / Redis
# The web process schedules jobs; a separate worker (`node ace queue:work --queue=documents`)
# runs them. `sync` runs jobs inline and needs no Redis (local commands only).
QUEUE_DRIVER=redis              # redis | sync
REDIS_HOST=127.0.0.1
REDIS_PORT=6379                 # docker-compose.yml maps Redis to 6380
REDIS_PASSWORD=                 # optional
REDIS_TLS=false                 # true for managed Redis that requires TLS (e.g. Upstash)

# ---------------------------------------------------------------- RAG / embeddings
RAG_PIPELINE_VERSION=2
RAG_EMBEDDING_DIMENSIONS=1024   # 768 or 1024 are indexed
# openrouter (default, uses OPENROUTER_EMBEDDING_MODEL) | ollama
EMBEDDING_PROVIDER=openrouter
# For a local Ollama server instead:
# EMBEDDING_PROVIDER=ollama
# EMBEDDING_BASE_URL=http://127.0.0.1:11434/v1
# EMBEDDING_MODEL=embeddinggemma-2:740m
# EMBEDDING_API_KEY=
# RAG_EMBEDDING_DIMENSIONS=768

# Contextual chunking: off = structural context only | ollama | openrouter
CONTEXTUALIZER=off
# CONTEXTUALIZER_MODEL=           # required for ollama (a local chat model)
# CONTEXTUALIZER_BASE_URL=

# ---------------------------------------------------------------- PDF extraction (python/pdf_worker)
# pymupdf | pdf-parse. Defaults to pymupdf in dev and pdf-parse in production.
PDF_EXTRACTOR=pymupdf
# The Docker image sets PDF_WORKER_PYTHON to its venv; locally run `bun run python:setup`.
# PDF_WORKER_PYTHON=
# PDF_WORKER_POOL_SIZE=2
# PDF_WORKER_TIMEOUT_MS=120000
# PDF_WORKER_MAX_REQUESTS=200
# PDF_WORKER_THREADS=2

# ---------------------------------------------------------------- Generation
# New case studies use the branded structured entry. Set to legacy for the old portfolio outline.
# GENERATION_FORMAT=branded       # branded | legacy
# PUBLICATION_LAYOUT=pilot        # pilot | templates
# CANVAS_EDITOR=pilot             # free layout editor for brochures (GrapesJS)
# CANVAS_GENERATION=on            # portfolio multi-stage page generation in the canvas (needs CANVAS_EDITOR=pilot)
# CANVAS_PLANNER_MODEL=           # plan; defaults to OPENROUTER_MODEL
# CANVAS_WRITER_MODEL=            # page prose; defaults to the planner model (a Sonnet-class model is recommended)
# CANVAS_DESIGN_MODEL=            # "Let AI choose" page design; defaults to the planner model (an image-capable model also sees reference pictures)

# ---------------------------------------------------------------- Mail (SMTP)
MAIL_MAILER=smtp
MAIL_FROM_NAME=HumbleBeeAI
MAIL_FROM_ADDRESS=hello@example.test
# Local Mailpit from docker-compose.yml listens on 1025 (UI on :8025). Production: authenticated SMTP.
SMTP_HOST=127.0.0.1
SMTP_PORT=1026
SMTP_SECURE=false               # true = implicit TLS (465); false = STARTTLS/plain
SMTP_USERNAME=
SMTP_PASSWORD=