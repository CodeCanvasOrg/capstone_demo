# Production configuration for terraform/vercel, as environment variables.
# Copy to .env (git-ignored), fill in, then load it before running Terraform:
#
#   cp .env.example .env
#   set -a; . ./.env; set +a
#   terraform init && terraform apply
#
# Terraform reads every input variable from TF_VAR_<name>, so this file can replace
# terraform.tfvars entirely. If you use both, values in terraform.tfvars win.
# Uncommented = required. Commented = optional; the value shown is the default.
# Terraform turns these into the app's env vars (start/env.ts) on Vercel and Railway; see env.tf.

# ================================================================ Provider credentials (required)
VERCEL_API_TOKEN=                       # vercel.com/account/tokens
RAILWAY_TOKEN=                          # railway.com/account/tokens (account or workspace token)
RAILWAY_API_TOKEN=${RAILWAY_TOKEN}      # same token, for `railway up` (Railway CLI)
TF_VAR_neon_api_key=                    # console.neon.tech > Account settings > API keys
TF_VAR_upstash_email=                   # console.upstash.com > Account > Management API
TF_VAR_upstash_api_key=

# ================================================================ General
TF_VAR_github_repo=CodeCanvasOrg/capstone_demo   # Vercel + Railway GitHub apps need access
# TF_VAR_project_name=capstone          # names the Vercel/Neon/Upstash/Railway projects
# TF_VAR_environment=prod
# TF_VAR_production_branch=main         # both platforms deploy on push to this branch

# ================================================================ Vercel (web)
# TF_VAR_vercel_team=                   # team slug or ID; empty = personal account
# TF_VAR_vercel_region=iad1             # keep next to the database (iad1 = us-east-1)
TF_VAR_domain_name=app.example.com      # -> APP_URL=https://<domain>; empty = https://<project_name>.vercel.app
# TF_VAR_deploy_on_apply=true           # first production deploy right after apply

# ================================================================ Neon (Postgres + pgvector, Object Storage)
# -> DB_HOST, DB_PORT, DB_USER, DB_PASSWORD, DB_DATABASE, DB_URL (web: pooled, worker: direct)
# TF_VAR_neon_org_id=                   # required if the API key belongs to an organization
# TF_VAR_neon_region=aws-us-east-1      # must support Object Storage: aws-us-east-1 | aws-us-east-2 | aws-eu-central-1 | aws-ap-southeast-1
# TF_VAR_db_name=capstone
# TF_VAR_db_username=capstone
# TF_VAR_neon_min_cu=0.25
# TF_VAR_neon_max_cu=2
# -> DRIVE_DISK=s3, S3_BUCKET, S3_REGION, S3_ENDPOINT, S3_ACCESS_KEY_ID, S3_SECRET_ACCESS_KEY
# TF_VAR_uploads_bucket_name=uploads

# ================================================================ Upstash (Redis queue)
# -> QUEUE_DRIVER=redis, REDIS_HOST, REDIS_PORT, REDIS_PASSWORD, REDIS_TLS=true
# TF_VAR_upstash_primary_region=us-east-1

# ================================================================ Railway (queue worker)
# The worker runs the repo Dockerfile with APP_ROLE=worker and runs migrations before each deploy.
# TF_VAR_railway_workspace_id=          # empty = the token's default workspace
# TF_VAR_railway_region=us-east4-eqdc4a

# ================================================================ App
# TF_VAR_app_name=CodeCanvas            # -> APP_NAME
# TF_VAR_app_key=                       # -> APP_KEY; empty = generated (node ace generate:key); changing it logs everyone out
# TF_VAR_log_level=info                 # -> LOG_LEVEL
# Set by Terraform, not configurable: NODE_ENV=production HOST=0.0.0.0 PORT=3333 TZ=UTC SESSION_DRIVER=cookie

# ================================================================ OpenRouter (LLM + embeddings)
TF_VAR_openrouter_api_key=                                # -> OPENROUTER_API_KEY
# TF_VAR_openrouter_model=anthropic/claude-haiku-5.5      # -> OPENROUTER_MODEL
# TF_VAR_openrouter_embedding_model=perplexity/pplx-embed-v1-4b   # -> OPENROUTER_EMBEDDING_MODEL

# ================================================================ RAG / generation
# TF_VAR_rag_pipeline_version=2         # -> RAG_PIPELINE_VERSION
# TF_VAR_rag_embedding_dimensions=1024  # -> RAG_EMBEDDING_DIMENSIONS
# TF_VAR_generation_format=branded      # -> GENERATION_FORMAT (branded | legacy)
# TF_VAR_worker_pdf_extractor=pdf-parse # -> PDF_EXTRACTOR on the worker (pymupdf | pdf-parse); web is always pdf-parse
# Set by Terraform: EMBEDDING_PROVIDER=openrouter CONTEXTUALIZER=off

# ================================================================ Mail (SMTP: SES, Resend, Postmark, ...)
TF_VAR_smtp_host=email-smtp.us-east-1.amazonaws.com   # -> SMTP_HOST
TF_VAR_smtp_username=                                 # -> SMTP_USERNAME
TF_VAR_smtp_password=                         # -> SMTP_PASSWORD
TF_VAR_mail_from_address=hello@example.com            # -> MAIL_FROM_ADDRESS (a verified sender)
# TF_VAR_smtp_port=587                  # -> SMTP_PORT
# TF_VAR_smtp_secure=false              # -> SMTP_SECURE; true for implicit TLS on 465
# TF_VAR_mail_from_name=HumbleBeeAI     # -> MAIL_FROM_NAME

# ================================================================ Extra app env (web + worker)
# Any other start/env.ts variable, as an HCL map. For example:
# TF_VAR_extra_env='{ OPENROUTER_TIMEOUT_MS = "180000", PUBLICATION_LAYOUT = "templates" }'
