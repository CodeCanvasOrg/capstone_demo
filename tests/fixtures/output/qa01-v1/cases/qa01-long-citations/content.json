          }
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "Mitigations for the middle programmes were agreed late."
        },
        {
          "type": "sourceCitation",
          "attrs": {
            "sourceChunkId": "0f6437db-2944-40ba-8ede-70b7cb053c4a"
          }
        },
