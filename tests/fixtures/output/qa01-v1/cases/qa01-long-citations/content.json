          "type": "text",
          "text": "Resilience Assessment Across Six Programmes"
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "A fictional assessment draws on six long-named reports, two pages each."
        },
        {
          "type": "sourceCitation",
          "attrs": {
            "sourceChunkId": "4bbd7293-284b-4d91-8495-760034339a57"
          }
        },
