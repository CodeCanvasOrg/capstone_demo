          "type": "text",
          "text": "Findings"
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "Risks in the first three programmes recur in later reports."
        },
        {
          "type": "sourceCitation",
          "attrs": {
            "sourceChunkId": "4bbd7293-284b-4d91-8495-760034339a57"
