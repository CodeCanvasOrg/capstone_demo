SESSION_DRIVER=memory

# Keep automated tests isolated from the development S3 bucket.
DRIVE_DISK=s3
S3_ENDPOINT=http://127.0.0.1:55999
S3_BUCKET=test
S3_ACCESS_KEY_ID=test
S3_REGION=us-east-1
S3_SECRET_ACCESS_KEY=test

# Provider calls in automated tests never inherit the live development key.
OPENROUTER_API_KEY=local-synthetic-test-only

# Existing generation tests exercise the legacy portfolio outline; branded generation has its own tests.
GENERATION_FORMAT=legacy
